options:
  parameters:
    author: JACON clinic team
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Pluto CW transmitter (frequency + power) with RX monitor and TX/RX
      time + frequency plots
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: pluto_safe_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Pluto CW TX with output power limit
    window_size: (1400,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,2
    label: TX frequency (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 325e6
    step: 1e6
    stop: 3.8e9
    value: 1.2e9
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 8]
    rotation: 0
    state: enabled
- name: p_dbm
  id: variable_qtgui_range
  parameters:
    comment: requested output power. The slider cannot go above p_limit_dbm.
    gui_hint: 1,0,1,1
    label: TX power (dBm, approx). Limited to p_limit_dbm
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: p_max_dbm - 89.75
    step: '0.25'
    stop: p_max_dbm - att_min_db
    value: p_max_dbm - att_min_db - 10
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 8]
    rotation: 0
    state: enabled
- name: p_max_dbm
  id: variable
  parameters:
    comment: 'CALIBRATE: power measured at 0 dB attenuation at your frequency (Pluto
      ~0..+7 dBm, frequency dependent)'
    value: '5.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 8]
    rotation: 0
    state: enabled
- name: p_limit_dbm
  id: variable
  parameters:
    comment: 'SAFETY LIMIT: the most power the part under test may receive. The flowgraph
      cannot transmit more than this. Change it here on purpose, never with a slider.
      Buffer amp ZX60-14012L max +10 dBm. IF amp P103LN max +21. IF amp 2534MA max
      -15: set this to -35 for that part.'
    value: '-20.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 96]
    rotation: 0
    state: enabled
- name: p_worst_max_dbm
  id: variable
  parameters:
    comment: the highest output the Pluto could possibly give at 0 dB attenuation.
      Used only to compute the attenuation floor, so the limit holds even if p_max_dbm
      is set too low.
    value: '11.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 184]
    rotation: 0
    state: enabled
- name: att_min_db
  id: variable
  parameters:
    comment: attenuation floor. The Pluto attenuation is never set below this.
    value: max(0.0, p_worst_max_dbm - p_limit_dbm)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 272]
    rotation: 0
    state: enabled
- name: pluto_uri
  id: variable
  parameters:
    comment: network address over the Pluto's USB-Ethernet gadget; lets TX and RX
      blocks share one Pluto
    value: '''ip:192.168.2.1'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 324.0]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
    label: RX gain (dB, manual)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '73'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 8]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'BASEBAND rate: plots cover freq +/- samp_rate/2. The Pluto does the
      GHz mixing, so this is NOT 2x the RF'
    value: 2.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 204.0]
    rotation: 0
    state: enabled
- name: tone_offset
  id: variable
  parameters:
    comment: baseband sine frequency (keep << samp_rate/2); Pluto LO = freq - tone_offset
      so the RF tone lands exactly on freq. Do NOT put the RF frequency here
    value: 50e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 148.0]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.7'
    comment: complex sine at +tone_offset -> single RF tone at freq
    freq: tone_offset
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 240]
    rotation: 0
    state: enabled
- name: iio_pluto_sink_0
  id: iio_pluto_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: min(89.75, max(att_min_db, p_max_dbm - p_dbm))
    bandwidth: '20000000'
    buffer_size: '32768'
    comment: attenuation = p_max_dbm - p_dbm, never less than att_min_db
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: int(freq - tone_offset)
    fstop: '0'
    len_tag_key: ''
    samplerate: int(samp_rate)
    type: fc32
    uri: pluto_uri
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 200]
    rotation: 0
    state: enabled
- name: iio_pluto_source_0
  id: iio_pluto_source
  parameters:
    affinity: ''
    alias: ''
    bandwidth: '20000000'
    bbdc: 'True'
    buffer_size: '32768'
    comment: loop TX -> attenuator (>=30 dB) -> RX to see the real output
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: int(freq - tone_offset)
    fstop: '0'
    gain1: '''manual'''
    len_tag_key: ''
    manual_gain1: rx_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    quadrature: 'True'
    rfdc: 'True'
    samplerate: int(samp_rate)
    type: fc32
    uri: pluto_uri
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 580]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_rx
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'True'
    fc: freq - tone_offset
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 3,0,1,1
    label: Relative Gain
    label1: '""'
    label10: '""'
    label2: '""'
    label3: '""'
    label4: '""'
    label5: '""'
    label6: '""'
    label7: '""'
    label8: '""'
    label9: '""'
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"RX (spectrum, RF axis)"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.20'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-140'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 580]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_tx
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'True'
    fc: freq - tone_offset
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 2,0,1,1
    label: Relative Gain
    label1: '""'
    label10: '""'
    label2: '""'
    label3: '""'
    label4: '""'
    label5: '""'
    label6: '""'
    label7: '""'
    label8: '""'
    label9: '""'
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"TX baseband -> Pluto (spectrum, RF axis)"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.20'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-140'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 330]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_rx
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'True'
    entags: 'False'
    grid: 'True'
    gui_hint: 3,1,1,1
    label1: I (real)
    label10: Signal 10
    label2: Q (imag)

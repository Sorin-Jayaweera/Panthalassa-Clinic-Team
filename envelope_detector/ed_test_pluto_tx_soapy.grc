options:
  parameters:
    author: JACON clinic team
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Test A: 1.1 GHz tone from the Pluto into the envelope detector.
      Slider = TX level, checkbox = pulsed.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ed_test_pluto_tx_soapy
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Test A - Pluto tone for the envelope detector
    window_size: (600,150)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable
  parameters:
    comment: RF frequency. Change to 1.0e9 / 1.2e9 for Step 5
    value: 1.1e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: pulse_us
  id: variable
  parameters:
    comment: pulse width in microseconds (the gap between pulses is the same length)
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: pulsed
  id: variable_qtgui_check_box
  parameters:
    comment: unchecked = steady tone (CW), checked = on/off pulses
    'false': '0'
    gui_hint: 1,0,1,1
    label: Pulsed
    'true': '1'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: tx_level
  id: variable_qtgui_range
  parameters:
    comment: 'starts at the minimum. 0 = full power. This is the "TX atten" column
      in the procedure'
    gui_hint: 0,0,1,1
    label: TX level (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-89'
    step: '1'
    stop: '0'
    value: '-89'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 12]
    rotation: 0
    state: enabled
- name: tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.7'
    comment: 100 kHz tone; the Pluto is tuned 100 kHz low so the RF lands exactly
      on freq
    freq: 100e3
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 120]
    rotation: 0
    state: enabled
- name: gate
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: pulsed
    comment: 'on/off switch: always 1 when not pulsed, 0/1 square wave when pulsed'
    freq: 1e6 / (2 * pulse_us)
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: 1 - pulsed
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SQR_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 260]
    rotation: 0
    state: enabled
- name: blocks_float_to_complex_0
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 296]
    rotation: 0
    state: enabled
- name: blocks_multiply_xx_0
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: tone x on/off
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 184]
    rotation: 0
    state: enabled
- name: soapy_plutosdr_sink_0
  id: soapy_plutosdr_sink
  parameters:
    affinity: ''
    alias: ''
    bandwidth: '20000000'
    center_freq: freq - 100e3
    comment: Soapy gain 0..89 dB, so gain = 89 + tx_level
    dev_args: ''
    gain: 89 + tx_level
    samp_rate: samp_rate
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 168]
    rotation: 0
    state: enabled

connections:
- [blocks_float_to_complex_0, '0', blocks_multiply_xx_0, '1']
- [blocks_multiply_xx_0, '0', soapy_plutosdr_sink_0, '0']
- [gate, '0', blocks_float_to_complex_0, '0']
- [tone, '0', blocks_multiply_xx_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0

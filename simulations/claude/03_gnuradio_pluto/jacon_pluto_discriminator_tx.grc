- name: iio_pluto_sink_0
  id: iio_pluto_sink
  parameters:
    type: fc32
    uri: ''
    frequency: int(f_tx - tone_offset)
    samplerate: int(samp_rate)
    buffer_size: '32768'
    cyclic: 'False'
    attenuation1: atten
    len_tag_key: ''
    filter_source: '''Auto'''

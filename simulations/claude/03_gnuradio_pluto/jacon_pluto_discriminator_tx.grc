    fpass: '0'
    fstop: '0'
    bandwidth: '20000000'
    comment: uri empty = first Pluto on USB; or ip:192.168.2.1
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 840
    - 300
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '"Baseband sent to Pluto (0 Hz = Pluto LO, tone sits at +tone_offset)"'
    fftsize: '2048'
    freqhalf: 'True'
    wintype: window.WIN_BLACKMAN_hARRIS
    norm_window: 'False'
    fc: '0'
    bw: samp_rate
    grid: 'True'
    autoscale: 'False'
    average: '1.0'
    ymin: '-140'
    ymax: '10'
    label: Relative Gain
    units: dB
    nconnections: '1'
    update_time: '0.10'
    showports: 'False'
    gui_hint: 3,0,1,2
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: '0.0'

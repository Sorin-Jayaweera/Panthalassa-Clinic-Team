options:
  parameters:
    author: JACON clinic team
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: PlutoSDR TX source for bench-testing the JACON delay-line frequency discriminator (1.0-1.2 GHz)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: jacon_pluto_discriminator_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: JACON - Pluto TX for the delay-line discriminator test
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 2.5e6
    comment: Pluto baseband rate (keep >= 2.084 MSPS)
    alias: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 8
    rotation: 0
    state: enabled
- name: tone_offset
  id: variable
  parameters:
    value: 200e3
    comment: tone sits this far above the Pluto LO (keeps LO leakage off the wanted tone)
    alias: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 8
    rotation: 0
    state: enabled
- name: amp
  id: variable
  parameters:
    value: '0.9'
    comment: digital amplitude (<1)
    alias: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 8
    rotation: 0
    state: enabled
- name: f_tx
  id: variable
  parameters:
    value: f_manual
    comment: actual RF frequency; the sweep thread overrides it in mode 1
    alias: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 580
    - 8
    rotation: 0
    state: enabled
- name: sweep_start

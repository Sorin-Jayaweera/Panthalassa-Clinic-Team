TEXT 1406 2534 Left 3 ;[9] VCO + FPGA MORSE KEYING
TEXT 0 -360 Left 7 ;JACON  -  Jason's RACON draft design  (LTspice behavioral model)
TEXT 0 -240 Left 3 ;RX 9.3-9.5 GHz radar pulse -> 1.1 GHz IF -> detect + measure frequency with a delay line -> hold -> VCO -> key Morse '. - .' -> mix back up with the same LO -> TX at the radar frequency.
TEXT 0 -160 Left 2 ;Every net is named: click a label to plot it. Voltages are RF amplitudes in 50 ohm: P(dBm) = 10*log10(V^2/100m).  Block models: jacon_blocks.inc.  Python plots: run_tests.py
TEXT 4400 120 Left 3 !.param TEST=0   ; <<<<<<<<<<<<  CHANGE THIS NUMBER TO PICK WHAT TO SIMULATE  >>>>>>>>>>>>\n.param TSTOP=table(TEST, 0,2.1u, 1,40n, 2,5n, 3,20n, 4,650n, 5,60n, 6,176n, 7,4u, 8,50n, 9,460n, 10,300n)\n.param TMAX=table(TEST, 0,2.5p, 1,2.5p, 2,1p, 3,2.5p, 4,20p, 5,10p, 6,10p, 7,0.5n, 8,10p, 9,2.5p, 10,2.5p)\n.tran 0 {TSTOP} 0 {TMAX}\n.include jacon_blocks.inc
TEXT 4400 480 Left 2 ;TEST  what is exercised                          -> nets worth plotting\n  0   FULL SYSTEM                radar pulse in -> detect -> measure f -> hold -> VCO -> Morse '. - .' out at the radar frequency\n      probe: rf_ant, env, det, lim_out, pd_out, sh_hold, vtune, vco_f_GHz, key, tx_out\n  1   RX FRONT END               CW 9.4 GHz power ramp P1_START..P1_STOP through limiter + LNA (compression / protection)\n      probe: rf_ant, rf_lim, rf_lna\n  2   LO CHAIN                   8.3 GHz PLL -> buffer -> splitter: LO drive levels at both mixers\n      probe: lo_pll, lo_buf, lo_rx, lo_tx\n  3   RX DOWNCONVERSION          CW radar -> LNA -> mixer -> IF amp: 1.1 GHz IF, 17.7 GHz sum, LO leak\n      probe: rf_lna, if_mix, if_amp   (View > FFT)\n  4   PULSE DETECTION            IF pulses of rising power -> envelope detector -> comparator vs DAC threshold\n      probe: if_split_in, env, vth, det_raw\n  5   LIMITING AMP               IF CW ramp P5_START..P5_STOP -> 3-stage limiter: output amplitude flattens\n      probe: lim_in, lim_out\n  6   DELAY-LINE DISCRIMINATOR   IF staircase 1.00..1.20 GHz (first step held twice to settle) -> limiter -> splitter -> delay lines -> phase detector (calibration)\n      probe: lim_out, pd_rf, pd_lo, pd_out\n  7   SAMPLE/HOLD + OP-AMP       ideal phase-detector levels + detect pulses -> S&H -> scaling op-amp (settling)\n      probe: sh_in, det, sh_ctrl, sh_hold, vtune_opa\n  8   VCO                        tune-voltage ramp VT8_START..VT8_STOP -> VCO frequency\n      probe: vtune, vco_f_GHz, if_vco\n  9   TX CHAIN                   VCO @ VT_CENTER keyed '. - .' -> up-mixer -> image-reject HPF -> PA\n      probe: key, if_keyed, tx_mix, tx_filt, tx_out   (View > FFT)\n 10   RX->TX FREQUENCY TRANSFER  pulse in, measure settled VCO f (use .step param F_RADAR ...; op-amp made fast)\n      probe: add  .step param F_RADAR list 9.3e9 9.35e9 9.4e9 9.45e9 9.5e9 ; plot vco_f_GHz
RECTANGLE Normal 6700 1400 4360 -20 2
TEXT 4400 -40 Left 5 ;TEST SELECT
TEXT 4400 1560 Left 5 ;PARAMETERS  (part values from the drawing; 'check' = assumed)
TEXT 4400 1640 Left 1 !* ---- [0] RADAR ECHO STIMULUS ----\n.param F_RADAR=9.4e9   ; radar frequency (9.3-9.5 GHz)\n.param P_RADAR=-30     ; echo power at RX antenna port, dBm (-50 distant .. -10 close)\n.param T_PULSE_ON=20n  ; pulse start\n.param PW_RADAR=150n   ; pulse width (real radars 50 ns - 1.2 us)\n.param T_RISE=1n       ; pulse edge time constant\n.param P1_START=-60    ; TEST 1 ramp start (dBm)\n.param P1_STOP=20      ; TEST 1 ramp stop (dBm)
TEXT 5900 1640 Left 1 !* ---- [1] RX RF FRONT END ----\n.param LIM_PMAX=17  ; power limiter flat leakage, dBm (Aaronia SMA limiter: 17 dBm @ 10 GHz)\n.param LIM_IL=0.5   ; limiter insertion loss, dB (assumed)\n.param ATT_RX=0     ; optional in-line attenuator to keep LNA < +15 dBm, dB\n.param LNA_G=22     ; ZX60-5123LN+ gain, dB\n.param LNA_P1DB=17  ; ZX60-5123LN+ output P1dB, dBm
TEXT 5900 1884 Left 1 !* ---- [2] LO GENERATION ----\n.param F_LO=8.3e9      ; ADF5355 frequency\n.param P_PLL=3         ; ADF5355 output power at 8.3 GHz, dBm (VERIFY on your module)\n.param LOBUF_G=12      ; ZX60-14012L-S+ gain, dB\n.param LOBUF_P1DB=14   ; ZX60-14012L-S+ output P1dB, dBm (assumed - check datasheet)\n.param LOSPLIT_IL=0.7  ; ZX10-2-1252-S+ excess loss, dB (on top of 3 dB split)
TEXT 4400 1952 Left 1 !* ---- [1][8] MIXERS (ZX05-14LH-S+) ----\n.param MIX_CL=6.7       ; conversion loss, dB\n.param MIX_LO_NOM=10    ; LO level the loss is quoted at, dBm (LH = +10)\n.param MIX_IFBW=4e9     ; IF port bandwidth (DC-4 GHz)\n.param MIX_LOIF_ISO=25  ; LO->IF isolation, dB (assumed)\n.param MIX_LORF_ISO=30  ; LO->RF isolation, dB (assumed)
TEXT 5900 2128 Left 1 !* ---- [3] IF CHAIN ----\n.param IFA_G=22.5      ; ZX60-P162LN+ gain, dB\n.param IFA_P1DB=18     ; ZX60-P162LN+ output P1dB, dBm (assumed - check)\n.param IFA_FHP=300e6   ; IF amp low corner (1-pole model)\n.param IFA_FLP=2.5e9   ; IF amp high roll-off (3rd-order model)\n.param F_IF_NOM=1.1e9  ; nominal IF used to normalise gains
TEXT 4400 2196 Left 1 !* ---- [4] PULSE DETECTION ----\n.param ENV_BW=130e6   ; ADL5511 envelope bandwidth\n.param ENV_K=1        ; envelope out per volt of IF peak (idealised - check ADL5511 slope)\n.param ENV_OFS=0      ; envelope output offset, V (ADL5511 real part has ~VREF offset)\n.param VTH_DAC=15m    ; nanoDAC comparator threshold, V\n.param COMP_VOD=0.5m  ; ADCMP600 overdrive for full swing, V\n.param COMP_TPD=3.5n  ; ADCMP600 propagation delay
TEXT 5900 2372 Left 1 !* ---- [5] LIMITING AMP ----\n.param LIMA_G=17       ; gain per stage, dB (GALI-52+ / ERA-33SM+ class)\n.param LIMA_P1DB=12    ; output P1dB per stage, dBm\n.param LIMA_FLP=1.6e9  ; harmonic clean-up low-pass after the limiter
TEXT 4400 2474 Left 1 !* ---- [6] DELAY-LINE DISCRIMINATOR ----\n.param VF=0.70         ; coax velocity factor (PTFE ~0.70, foam ~0.8x, air 1.0)\n.param L_REF_IN=6      ; reference arm length, inches\n.param DL_IN=4.5       ; EXTRA length of delayed arm, inches  <-- design variable\n.param COAX_DB_FT=0.4  ; coax loss at ~1.1 GHz, dB/ft (RG-316 ~0.4)\n.param MIXMODE=1       ; phase detector: 0 = ideal multiplier, 1 = double-balanced mixer\n.param PD_CL=6         ; ZX05-30W-S+ conversion loss, dB\n.param PD_LO_NOM=7     ; ZX05-30W-S+ LO level, dBm (Level 7)\n.param PD_FLP=100e6    ; phase-detector output low-pass (removes 2f)
TEXT 5900 2548 Left 1 !* ---- [7] SAMPLE/HOLD + SCALING ----\n.param SH_DLY=40n      ; FPGA: sample starts this long after detect\n.param SH_WIDTH=40n    ; FPGA: sample window length\n.param SH_RON=120      ; ADG1211 on-resistance, ohm (check datasheet)\n.param SH_ROFF=1G      ; ADG1211 off-resistance\n.param SH_C=100p       ; C0G hold capacitor\n.param PD_V0=-0.3372   ; phase-detector volts at F_IF_NOM  (from TEST 6 calibration; redo if you change [5]/[6])\n.param OPA_GAIN=19.46  ; op-amp gain, V/V  (from TEST 6 calibration; redo if you change [5]/[6]/VCO)\n.param VT_CENTER=7.75  ; VCO tune voltage for F_IF_NOM\n.param OPA_VMIN=0      ; op-amp output low rail, V\n.param OPA_VMAX=11.5   ; op-amp output high rail, V\n.param OPA_GBW=8e6     ; ADA4622 gain-bandwidth, Hz (check) - sets tune settling
TEXT 4400 2820 Left 1 !* ---- [9] VCO + MORSE KEYING ----\n.param VCO_V1=6            ; CVCO55BE tune point 1, V\n.param VCO_F1=1.0e9        ; ... frequency at VCO_V1\n.param VCO_V2=9.5          ; CVCO55BE tune point 2, V\n.param VCO_F2=1.2e9        ; ... frequency at VCO_V2\n.param VCO_FMIN=0.8e9      ; VCO lower limit\n.param VCO_FMAX=1.6e9      ; VCO upper limit\n.param P_VCO=3             ; VCO output power, dBm (check datasheet)\n.param MORSE_UNIT=60n      ; Morse dot length (SHORTENED for simulation; real racon ~us)\n.param MORSE_HOLDOFF=1.6u  ; FPGA delay from detection to first dot\n.param KEY_TR=2n           ; ADG901 switching time constant\n.param KEY_ISO=40          ; ADG901 off isolation at 1 GHz, dB (check)\n.param KEY_IL=1            ; ADG901 insertion loss, dB
TEXT 5900 2996 Left 1 !* ---- [8] TX RF CHAIN ----\n.param IRF_FC=8.2e9  ; image-reject HPF ripple corner (9th-order 0.5 dB Chebyshev ~ VHF-8400+)\n.param IRF_IL=1.0    ; image-reject filter extra loss, dB\n.param PA_G=30       ; power amp gain, dB (ZVE-143-S+ class - check)\n.param PA_P1DB=30    ; power amp output P1dB, dBm (~1 W)
TEXT 5900 3206 Left 1 !* ---- TEST-BENCH STIMULI ----\n.param F_IF_TEST=1.1e9  ; IF test tone (tests 4, 5)\n.param P4_START=-35     ; TEST 4: first pulse power at IF splitter input, dBm\n.param P4_STEP=10       ; TEST 4: power step per pulse, dB\n.param T4_PER=150n      ; TEST 4: pulse period\n.param T4_PW=60n        ; TEST 4: pulse width\n.param P5_START=-50     ; TEST 5: ramp start at limiter input, dBm\n.param P5_STOP=5        ; TEST 5: ramp stop, dBm\n.param P6=-20           ; TEST 6: tone power at limiter input, dBm\n.param F6_START=1.0e9   ; TEST 6: staircase start\n.param F6_STEP=10e6     ; TEST 6: staircase step\n.param T6_STEP=8n       ; TEST 6: time per step\n.param T7_PER=1u        ; TEST 7: sample period\n.param T7_PW=100n       ; TEST 7: detect pulse width\n.param T7_DV=0.05       ; TEST 7: phase-detector level step, V\n.param VT8_START=5      ; TEST 8: tune ramp start, V\n.param VT8_STOP=10.5    ; TEST 8: tune ramp stop, V
RECTANGLE Normal 7400 3864 4360 1510 2
